NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
REGUA_CRON_SECRET=

# OCR fallback para PDFs com texto corrompido (HFlex/LiveFacilities, Metrocasa etc.)
# Requer binários do sistema no PATH: pdftoppm (Poppler) e tesseract com idioma por/eng.
GKLI_OCR_FALLBACK=true
GKLI_OCR_MAX_PAGES=80
GKLI_OCR_DPI=120
