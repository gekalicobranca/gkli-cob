import assert from 'node:assert/strict';
import {readFileSync} from 'node:fs';
import {PGlite} from '@electric-sql/pglite';
import * as titularModule from '../features/acordos/unidade-titular';
const {selecionarCobrancaTitular} = (titularModule as any).default ?? titularModule;
const db=new PGlite();
const id=(n:number)=>`00000000-0000-0000-0000-${String(n).padStart(12,'0')}`;
await db.exec(`create schema auth; create function auth.uid() returns uuid language sql as $$select '${id(99)}'::uuid$$;
create function current_user_can_access_carteira(uuid) returns boolean language sql as $$select $1='${id(80)}'::uuid$$;
create table profiles(id uuid,role text); insert into profiles values('${id(99)}','operador');
create table unidades(id uuid primary key,carteira_id uuid,condominio_id uuid);
insert into unidades values('${id(10)}','${id(80)}','${id(81)}'),('${id(11)}','${id(80)}','${id(81)}'),('${id(12)}','${id(80)}','${id(81)}'),('${id(13)}','${id(80)}','${id(82)}');
create table central_pendencias(carteira_id uuid,condominio_id uuid,unidade_id uuid,tipo text,status text);
create table cobrancas(id uuid primary key,duplicada_de_id uuid,carteira_id uuid,condominio_id uuid,unidade_id uuid,status text,status_operacional text);
insert into cobrancas values('${id(1)}',null,'${id(80)}','${id(81)}','${id(10)}','novo','novo'),('${id(2)}',null,'${id(80)}','${id(81)}','${id(11)}','novo','novo'),('${id(3)}',null,'${id(80)}','${id(82)}','${id(13)}','novo','novo'),('${id(4)}',null,'${id(80)}','${id(81)}','${id(11)}','novo','novo');
create table acordos(id uuid primary key default gen_random_uuid(),carteira_id uuid,cobranca_id uuid,condominio_id uuid,unidade_id uuid,tipo text,numero_processo text,valor_acordado numeric,entrada numeric,despesa_cobranca_percentual numeric,despesa_cobranca_valor numeric,data_acordo date,status text,fluxo_status text,exige_aprovacao_sindico boolean,documento_url text,observacoes text);
create table acordo_cobrancas(acordo_id uuid,cobranca_id uuid,valor_original_no_acordo numeric,valor_atualizado_no_acordo numeric,encargos_no_acordo numeric,valor_total_no_acordo numeric);
create table parcelas_acordo(acordo_id uuid,numero int,tipo_parcela text,valor numeric,vencimento date,status text);`);
await db.exec(readFileSync('scripts/fixtures/acordos/criar-acordo-financeiro-antes-multi.sql','utf8'));
const migration=readFileSync('supabase/migrations/20261026201008_acordo_multiplas_unidades_titular.sql','utf8');
await db.exec(migration);await db.exec(migration);
async function criar(ids:number[],titular=11,principal=ids[0],wallet=80){
 return (await db.query<{id:string}>(`select criar_acordo_financeiro($1,$2,$3,$4,'extrajudicial',null,100,0,10,10,current_date,'ativo','boletos_solicitados',false,null,null,$5,$6,'em_negociacao') id`,[id(wallet),id(principal),id(81),id(titular),JSON.stringify(ids.map(n=>({cobranca_id:id(n)}))),JSON.stringify([{numero:1,valor:50,vencimento:'2026-10-26'},{numero:2,valor:50,vencimento:'2026-11-26'}])])).rows[0].id;
}
const rows=[{id:id(1),unidade_id:id(10),carteira_id:id(80),condominio_id:id(81)},{id:id(2),unidade_id:id(11),carteira_id:id(80),condominio_id:id(81)}];
assert.equal(selecionarCobrancaTitular(rows,id(11)).id,id(2));
assert.throws(()=>selecionarCobrancaTitular(rows),/Escolha a unidade titular/);
assert.throws(()=>selecionarCobrancaTitular(rows,id(12)),/cobrança selecionada/);
assert.throws(()=>selecionarCobrancaTitular([rows[0],{...rows[1],condominio_id:id(82)}],id(10)),/mesmo condomínio/);
await assert.rejects(criar([1,2],12,1),/titular/);
await assert.rejects(criar([1,2],11,1),/titular/);
await assert.rejects(criar([1,3],10,1),/mesmo condomínio/);
await assert.rejects(criar([1,2],11,2,83),/Sem permissão/);
await db.exec(`insert into central_pendencias values('${id(80)}','${id(81)}','${id(10)}','planilha_debitos_administradora','aberta')`);
await assert.rejects(criar([1,2],11,2),/pendência/);
await db.exec('delete from central_pendencias');
await db.exec(`update cobrancas set status_operacional='judicializado' where id='${id(1)}'`);
await assert.rejects(criar([1,2],11,2),/judicializada/);
await db.exec(`update cobrancas set status_operacional='novo' where id='${id(1)}'`);
const acordo=await criar([1,2],11,2);
assert.equal((await db.query<{unidade_id:string}>('select unidade_id from acordos where id=$1',[acordo])).rows[0].unidade_id,id(11));
assert.equal((await db.query<{n:number}>('select count(distinct c.unidade_id)::int n from acordo_cobrancas ac join cobrancas c on c.id=ac.cobranca_id where ac.acordo_id=$1',[acordo])).rows[0].n,2);
await assert.rejects(criar([1],10,1),/já pertence ao acordo/);
await assert.rejects(criar([2,4],11,4),/já pertence ao acordo/);
assert.equal((await db.query<{n:number}>('select count(*)::int n from acordos')).rows[0].n,1);
assert.equal((await db.query<{n:number}>('select count(*)::int n from parcelas_acordo')).rows[0].n,2);
// Outro recibo da mesma unidade permanece permitido.
await criar([4],11,4);
console.log('OK: várias unidades, titular explícita, origem preservada, carteira/condomínio, pendência de participante, judicialização, duplicidade por cobrança, rollback e contagem única de parcelas.');
await db.close();
